# Backend configuration. Copy to `.env` and fill in DATABASE_URL + JWT_SECRET.
# Every value here maps to a field on Settings in app/core/config.py.

ENV=dev
DEBUG=true

# ===== Database (Neon) =====
# Paste the connection string from the Neon dashboard exactly as shown — the
# app rewrites the scheme to the async driver and strips the libpq-only query
# params (`sslmode`, `channel_binding`) that asyncpg rejects.
#   Neon > your project > Connect > Connection string
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-xxxx.REGION.aws.neon.tech/cms?sslmode=require
# Neon always requires TLS. (A `sslmode=require` above already implies this.)
DB_SSL=true
# Log every SQL statement — noisy; useful when debugging a query.
DB_ECHO=false

# ===== Security / JWT =====
# Must be at least 32 bytes for HS256. Generate: openssl rand -hex 32
JWT_SECRET=dev-insecure-change-me-0000000000000000
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL=900          # 15 minutes
REFRESH_TOKEN_TTL=2592000     # 30 days
MAX_SESSIONS_PER_USER=5

# Refresh cookie. For cross-site deploys (SPA on another domain) set
# COOKIE_SAMESITE=none and COOKIE_SECURE=true.
REFRESH_COOKIE_NAME=cms_refresh
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Super-admin bootstrap (python -m app.cli.seed_superadmin).
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change-me-please

# ===== CORS (comma-separated origins) =====
# The Angular dev server proxies /api same-origin, so this matters only for
# clients that call the API cross-origin.
CORS_ORIGINS=http://localhost:4200

# ===== Rate limiting (in-memory) =====
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_LOGIN=10/minute
